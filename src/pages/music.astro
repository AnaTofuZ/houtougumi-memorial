---
import BaseLayout from '../layouts/BaseLayout.astro';
import YoutubeEmbed from '../components/YoutubeEmbed.astro';
import { songs, playlistUrl } from '../data/music';

function formatDate(str: string) {
  return new Date(str).toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<BaseLayout title="音楽" description="宝灯桃汁と「ほうとう組。」の楽曲をまとめたページです。">
  <section class="pt-16 pb-10" data-scroll-bg="#D8FBF3">
    <div class="container mx-auto px-4 md:px-6 text-center">
      <p class="tag text-white mb-4 inline-block bg-[#159E85] font-bold">MUSIC</p>
      <h1 class="text-4xl md:text-5xl font-(family-name:--font-heading) font-extrabold mb-3 text-[#2AD1B2]">
        音楽
      </h1>
      <p class="text-base text-[#595959]">
        オリジナル曲と歌ってみたを<a href={playlistUrl} target="_blank" rel="noopener noreferrer" class="text-[#117B68] underline hover:no-underline">YouTubeプレイリスト</a>から紹介します。
      </p>
    </div>
  </section>

  <section class="pb-20" data-scroll-bg="#D8FBF3">
    <div class="container mx-auto px-4 md:px-6">
      <div class="max-w-2xl mx-auto space-y-4">
        {
          songs.map((song, index) => (
            <details class="card group p-0 overflow-hidden" open={index === 0}>
              <summary class="flex cursor-pointer select-none list-none items-center justify-between gap-4 px-6 py-5 marker:content-none">
                <div>
                  <h2 class="font-bold text-lg md:text-xl">{song.title}</h2>
                  <p class="text-sm text-[#595959] mt-1">{song.artists}</p>
                </div>
                <svg class="w-5 h-5 flex-shrink-0 text-[#159E85] transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <div class="border-t border-[#D8FBF3] p-4 md:p-6">
                <YoutubeEmbed videoId={song.youtubeId} title={song.title} />
                <p class="text-base text-[#1A1A1A] whitespace-pre-line leading-[1.75] mt-5">{song.description}</p>
                <div class="flex flex-wrap items-center gap-3 mt-4">
                  <span class="text-xs text-[#444444]">{formatDate(song.releaseDate)}</span>
                  {song.tags.map((tag) => (
                    <span class="tag bg-[#D8FBF3] text-[#117B68] text-xs">{tag}</span>
                  ))}
                  <a href={song.youtubeUrl} target="_blank" rel="noopener noreferrer" class="text-xs text-[#117B68] hover:underline font-bold">
                    YouTubeで見る ↗
                  </a>
                </div>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="pb-20" data-scroll-bg="#D8FBF3">
    <div class="container mx-auto px-4 md:px-6">
      <div class="card max-w-2xl mx-auto">
        <p class="tag bg-[#D8FBF3] text-[#117B68] text-xs mb-3 inline-block">GUEST VOICE</p>
        <h2 class="text-xl font-bold mb-2">TakeOff!!～ご当地VTuber日本紀行～</h2>
        <p class="text-base text-[#444444] leading-[1.75]">
          宝灯桃汁がセリフパートで参加した、ご当地VTuberオリジナルソングです。
        </p>
        <a href="https://tokotabi.wixsite.com/gotouchivsong" target="_blank" rel="noopener noreferrer" class="inline-flex mt-3 text-sm text-[#117B68] hover:underline font-bold">
          特設サイトで見る ↗
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
