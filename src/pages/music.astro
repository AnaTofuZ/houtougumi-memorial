---
import BaseLayout from '../layouts/BaseLayout.astro';
import YoutubeEmbed from '../components/YoutubeEmbed.astro';
import { songs, featuredSong } from '../data/music';

function formatDate(str: string) {
  return new Date(str).toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<BaseLayout title="音楽" description="ほうとう組のオリジナル曲をまとめたページです。">
  <!-- Page hero -->
  <section class="pt-16 pb-10" data-scroll-bg="#EFF9F7">
    <div class="container mx-auto px-4 md:px-6 text-center">
      <p class="tag text-white mb-4 inline-block bg-[#3A8A80] font-bold">MUSIC</p>
      <h1 class="text-4xl md:text-5xl font-[--font-heading] font-extrabold mb-3 text-[#4BA89E]">
        オリジナル曲
      </h1>
      <p class="text-sm text-[#595959]">※ こちらはダミーの説明文です。楽曲ページの説明文が入ります。</p>
    </div>
  </section>

  <!-- Featured song -->
  {featuredSong && (
    <section class="pb-16" data-scroll-bg="#EFF9F7">
      <div class="container mx-auto px-4 md:px-6">
        <div class="max-w-2xl mx-auto">
          <div class="card p-0 overflow-hidden">
            <!-- Header -->
            <div class="px-6 py-5 text-white bg-[#4BA89E]">
              <span class="tag bg-white/20 text-white text-xs mb-2 inline-block">FEATURED</span>
              <h2 class="text-2xl font-bold font-[--font-heading]">{featuredSong.title}</h2>
              <p class="text-sm opacity-80 mt-1">{featuredSong.artists}</p>
            </div>

            <!-- YouTube embed -->
            {featuredSong.youtubeId && (
              <div class="p-4">
                <YoutubeEmbed videoId={featuredSong.youtubeId} title={featuredSong.title} />
              </div>
            )}

            <!-- Description -->
            <div class="px-6 pb-6">
              <p class="text-sm text-[#1A1A1A] leading-relaxed mb-3">{featuredSong.description}</p>
              <div class="flex flex-wrap items-center gap-3">
                <span class="text-xs text-[#444444]">
                  {formatDate(featuredSong.releaseDate)}
                </span>
                {featuredSong.tags.map((tag) => (
                  <span class="tag bg-[#C8F0EC] text-[#4BA89E] text-xs">{tag}</span>
                ))}
              </div>
              {featuredSong.youtubeUrl && (
                <a
                  href={featuredSong.youtubeUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 mt-4 px-4 py-2 rounded-full bg-[#FF0000] text-white text-sm font-bold hover:opacity-90 transition-opacity"
                >
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                  </svg>
                  YouTubeで見る
                </a>
              )}
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- All songs list -->
  <section class="pb-20 py-16" data-scroll-bg="#FAFAFA">
    <div class="container mx-auto px-4 md:px-6">
      <h2 class="section-title text-xl md:text-2xl mb-8">すべての楽曲</h2>
      <div class="max-w-2xl mx-auto space-y-4">
        {
          songs.map((song) => (
            <div class="card flex items-start gap-4">
              <div class="w-16 h-16 rounded-xl flex-shrink-0 bg-[#C8F0EC]"></div>
              <div class="flex-1 min-w-0">
                <div class="flex items-start justify-between gap-2 mb-1">
                  <h3 class="font-bold text-base">{song.title}</h3>
                  {song.featured && (
                    <span class="tag bg-[#4BA89E] text-white text-xs flex-shrink-0">FEAT</span>
                  )}
                </div>
                <p class="text-sm text-[#444444] mb-2 line-clamp-2">{song.description}</p>
                <div class="flex flex-wrap items-center gap-2">
                  <span class="text-xs text-[#444444]">{formatDate(song.releaseDate)}</span>
                  {song.youtubeUrl && (
                    <a
                      href={song.youtubeUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-xs text-[#4BA89E] hover:underline font-medium"
                    >
                      YouTube ↗
                    </a>
                  )}
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
