---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="ページが見つかりません" description="お探しのページは見つかりませんでした。" noindex>
  <section class="container mx-auto px-4 py-24 text-center">
    <p class="font-(family-name:--font-en) text-sm font-bold tracking-widest text-[#EE3F87]">404 NOT FOUND</p>
    <h1 class="mt-3 text-3xl md:text-4xl">ページが見つかりません</h1>
    <p class="mt-4 text-[#555555]">URLが正しいかご確認ください。</p>
    <a href="/" class="btn-primary mt-8">トップへ戻る</a>
  </section>
</BaseLayout>
