---
import BaseLayout from '../layouts/BaseLayout.astro';
import GoodsCatalog from '../components/GoodsCatalog.astro';
---

<BaseLayout title="グッズ" description="「ほうとう組。」のグッズ紹介ページです。">
  <!-- Page hero -->
  <section class="pt-16 pb-10" data-scroll-bg="#EAF6FF">
    <div class="container mx-auto px-4 md:px-6 text-center">
      <p class="tag text-white mb-4 inline-block bg-[#1D86D9] font-bold">GOODS</p>
      <h1 class="text-4xl md:text-5xl font-[--font-heading] font-extrabold mb-3 text-[#1D86D9]">
        グッズ紹介
      </h1>
      <p class="mx-auto max-w-2xl text-base text-[#595959]">MOMOJIRU's STOREで公開された「ほうとう組。」のグッズを記録しています。販売状態や価格は取得時点の情報です。</p>
    </div>
  </section>

  <GoodsCatalog />
</BaseLayout>
