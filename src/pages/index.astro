---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import MemberCard from '../components/MemberCard.astro';
import Timeline from '../components/Timeline.astro';
import { members } from '../data/members';
import { timeline } from '../data/timeline';
import { fanarts } from '../data/fanart';
import { Image } from 'astro:assets';
import chibi from '../assets/images/members/chibi.png';
---

<BaseLayout title="トップ">
  <HeroSection />

  <section id="members" class="py-10 md:py-14" data-scroll-bg="#FFF0F7">
    <div class="container mx-auto px-4 md:px-8">
      <p class="text-center text-xs font-(family-name:--font-en) text-[#C22368] tracking-widest mb-2 font-bold">MEMBERS</p>
      <h2 class="section-title text-2xl md:text-3xl mb-4">メンバー</h2>
      <p class="text-center text-base text-[#595959] mb-12">
        ※ こちらはダミーの説明文です。メンバー紹介の文章が入ります。
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 md:gap-8">
        {members.map((member) => <MemberCard member={member} />)}
      </div>

      <div class="flex flex-wrap justify-center mt-16 md:mt-20 gap-4 md:gap-8 opacity-60">
        <Image src={chibi} alt="" aria-hidden="true" widths={[96, 200, 400]} sizes="(min-width: 768px) 200px, 96px" format="webp" loading="lazy" decoding="async" class="w-24 h-24 md:w-[200px] md:h-[200px] object-cover rounded-xl" style="transform: rotate(-6deg)" />
        <Image src={chibi} alt="" aria-hidden="true" widths={[96, 200, 400]} sizes="(min-width: 768px) 200px, 96px" format="webp" loading="lazy" decoding="async" class="w-24 h-24 md:w-[200px] md:h-[200px] object-cover rounded-xl" />
        <Image src={chibi} alt="" aria-hidden="true" widths={[96, 200, 400]} sizes="(min-width: 768px) 200px, 96px" format="webp" loading="lazy" decoding="async" class="w-24 h-24 md:w-[200px] md:h-[200px] object-cover rounded-xl" style="transform: rotate(6deg)" />
      </div>
    </div>
  </section>

  <section id="timeline" class="py-10 md:py-14" data-scroll-bg="#ECECEC">
    <div class="container mx-auto px-4 md:px-6">
      <p class="text-center text-xs font-(family-name:--font-en) text-[#555555] tracking-widest mb-2 font-bold">HISTORY</p>
      <h2 class="section-title text-2xl md:text-3xl mb-4">あゆみ</h2>
      <p class="text-center text-base text-[#595959] mb-12">
        ※ こちらはダミーのリード文です。「ほうとう組。」の歩みを振り返る文章が入ります。
      </p>
      <div class="max-w-3xl mx-auto">
        <Timeline events={timeline} />
      </div>
    </div>
  </section>

  <section class="py-10 md:py-14" data-scroll-bg="#D8FBF3">
    <div class="container mx-auto px-4 md:px-6">
      <div class="max-w-2xl mx-auto">
        <div class="flex justify-end mb-2 pr-6 opacity-70">
          <Image src={chibi} alt="" aria-hidden="true" width={400} format="webp" loading="lazy" decoding="async" class="w-[200px] h-[200px] object-cover object-top rounded-2xl" style="transform: rotate(5deg)" />
        </div>

        <a
          href="/music"
          class="group block rounded-3xl overflow-hidden shadow-md hover:shadow-lg hover:-translate-y-1 transition-all duration-300 bg-[#159E85] text-white"
        >
          <div class="px-8 py-10 text-white text-center">
            <p class="text-xs font-semibold mb-2 opacity-80 font-(family-name:--font-en) tracking-widest">ORIGINAL MUSIC</p>
            <h2 class="text-3xl font-bold mb-2 font-(family-name:--font-heading)">オリジナル曲</h2>
            <p class="text-base opacity-85 mb-6">
              ※ こちらはダミーの説明文です。オリジナル曲についての文章が入ります。
            </p>
            <span class="inline-flex items-center gap-2 bg-white/25 hover:bg-white/35 px-5 py-2 rounded-full text-sm font-bold transition-colors">
              聴いてみる
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section class="py-10 md:py-14" data-scroll-bg="#FCE8F0">
    <div class="container mx-auto px-4 md:px-6">
      <p class="text-center text-xs font-(family-name:--font-en) text-[#C22368] tracking-widest mb-2 font-bold">FAN ART</p>
      <h2 class="section-title text-2xl md:text-3xl mb-4">ファンイラスト</h2>
      <p class="text-center text-base text-[#595959] mb-10">
        「#桃汁ぱとろーる」などに寄せられた作品をご覧ください。
      </p>

      <div class="grid grid-cols-3 md:grid-cols-6 gap-3 max-w-2xl mx-auto mb-8">
        {
          fanarts.slice(0, 6).map((art) => (
            <a
              href="/fanart"
              class="aspect-square rounded-xl overflow-hidden hover:scale-105 transition-transform shadow-sm hover:shadow-md bg-[#FFD6E0]"
            >
              <Image
                src={art.type === 'video' ? art.poster : art.image}
                alt={art.alt}
                inferSize
                width={400}
                format="webp"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover"
              />
            </a>
          ))
        }
      </div>

      <div class="text-center">
        <a
          href="/fanart"
          class="group inline-flex items-center gap-2 px-6 py-2.5 rounded-full border-2 border-[#EE3F87] text-[#C22368] font-bold hover:bg-[#FCE8F0] transition-colors text-sm"
        >
          もっと見る
          <svg class="w-4 h-4 transition-transform duration-300 ease-out group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <section class="py-10 md:py-14" data-scroll-bg="#EAF6FF">
    <div class="container mx-auto px-4 md:px-6">
      <p class="text-center text-xs font-(family-name:--font-en) text-[#0D5FA0] tracking-widest mb-2 font-bold">VOICES</p>
      <h2 class="section-title text-2xl md:text-3xl mb-4">ファンの声</h2>
      <p class="text-center text-base text-[#595959] mb-10">
        ※ こちらはダミーの説明文です。ファンコメントの紹介文が入ります。
      </p>

      <div class="flex justify-start mb-8 pl-8 md:pl-24 opacity-60">
        <Image src={chibi} alt="" aria-hidden="true" width={400} format="webp" loading="lazy" decoding="async" class="w-[200px] h-[200px] object-cover object-top rounded-xl" style="transform: rotate(-4deg)" />
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 max-w-2xl mx-auto mb-8">
        {
          [
            { comment: 'これはダミーのコメントです。ファンの声の文章がここに入ります。', handle: '@dummy_001' },
            { comment: 'こちらもダミーのコメントです。実際のファンコメントが入ります。', handle: '@dummy_002' },
          ].map((c) => (
            <div class="card">
              <p class="text-base text-[#1A1A1A] leading-[1.75] mb-3">&ldquo;{c.comment}&rdquo;</p>
              <p class="text-xs text-[#555555] font-medium">{c.handle}</p>
            </div>
          ))
        }
      </div>
      <div class="text-center">
        <a
          href="/comments"
          class="group inline-flex items-center gap-2 px-6 py-2.5 rounded-full border-2 border-[#40ACFA] text-[#0D5FA0] font-bold hover:bg-[#DDF0FF] transition-colors text-sm"
        >
          コメントをもっと見る
          <svg class="w-4 h-4 transition-transform duration-300 ease-out group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
