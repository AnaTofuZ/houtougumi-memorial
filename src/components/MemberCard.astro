---
import type { MemberProfile } from '../data/members';

interface Props {
  member: MemberProfile;
}

const { member } = Astro.props;
const { id, name, tagline, color, colorLight, colorDark, illustrations } = member;
const coverImage = illustrations[0]?.src;
---

<a
  href={`/members/${id}`}
  class="group block card hover:shadow-xl hover:-translate-y-1 transition-all duration-300 overflow-hidden p-0"
>
  <!-- Illustration area (正方形) -->
  <div
    class="relative aspect-square overflow-hidden flex items-center justify-center"
    style={`background-color: ${colorLight}`}
  >
    <div
      class="absolute top-3 right-3 w-12 h-12 rounded-full opacity-25"
      style={`background-color: ${color}`}
    ></div>

    {
      coverImage ? (
        <img
          src={coverImage}
          alt={`${name} イラスト`}
          class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500"
          onerror="this.style.display='none'"
        />
      ) : (
        <span class="w-12 h-12 rounded-full border-2 opacity-30" style={`border-color: ${colorDark}`}></span>
      )
    }
  </div>

  <!-- Info area -->
  <div class="p-5">
    <div class="flex items-center gap-2 mb-1">
      <span class="w-3 h-3 rounded-full flex-shrink-0" style={`background-color: ${color}`}></span>
      <h3 class="text-lg font-bold" style={`color: ${colorDark}`}>{name}</h3>
    </div>
    <p class="text-base text-[#444444] mb-4 leading-[1.75]">{tagline}</p>
    <span
      class="inline-flex items-center gap-1 text-sm font-bold transition-colors"
      style={`color: ${colorDark}`}
    >
      詳しく読む
      <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </span>
  </div>
</a>
