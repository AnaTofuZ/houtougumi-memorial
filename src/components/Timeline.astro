---
import type { TimelineEvent } from '../data/timeline';
import { categoryColors } from '../data/timeline';

interface Props {
  events: TimelineEvent[];
}

const { events } = Astro.props;
const sorted = [...events].sort((a, b) => a.date.localeCompare(b.date));

function formatDate(dateStr: string) {
  const d = new Date(dateStr);
  return d.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<div class="relative">
  <!-- Vertical spine -->
  <div class="absolute left-5 md:left-1/2 top-0 bottom-0 w-0.5 -translate-x-1/2 bg-[#E0D0F0]"></div>

  <div class="space-y-10">
    {
      sorted.map((event, index) => {
        const isEven = index % 2 === 0;
        return (
          <div class={`relative flex md:gap-8 ${isEven ? 'md:flex-row' : 'md:flex-row-reverse'}`}>
            <!-- Timeline dot -->
            <div
              class="absolute left-5 md:left-1/2 -translate-x-1/2 w-5 h-5 rounded-full border-2 border-white shadow-md flex items-center justify-center z-10"
              style={`background-color: ${categoryColors[event.category]}`}
            >
            </div>

            <!-- Card side -->
            <div class={`pl-14 md:pl-0 md:w-1/2 ${isEven ? 'md:pr-10' : 'md:pl-10'}`}>
              <div class="card hover:shadow-lg transition-shadow group">
                <div class="flex flex-wrap items-center gap-2 mb-2">
                  <span class="tag text-white text-xs" style={`background-color: ${categoryColors[event.category]}`}>
                    {event.category}
                  </span>
                  <time class="text-xs text-[#444444]" datetime={event.date}>
                    {formatDate(event.date)}
                  </time>
                </div>
                <h3 class="font-bold text-base mb-1">{event.title}</h3>
                <p class="text-sm text-[#444444] leading-relaxed">{event.description}</p>
                {event.link && (
                  <a
                    href={event.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1 mt-2 text-sm text-[#FF8FAB] font-medium hover:underline"
                  >
                    詳細を見る
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  </a>
                )}
              </div>
            </div>

            <!-- Empty spacer for alternating layout -->
            <div class="hidden md:block md:w-1/2" />
          </div>
        );
      })
    }
  </div>
</div>
