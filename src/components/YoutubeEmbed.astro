---
import 'lite-youtube-embed/src/lite-yt-embed.css';

interface Props {
  videoId: string;
  title?: string;
  aspectRatio?: '16/9' | '4/3';
}

const { videoId, title = 'YouTube動画', aspectRatio = '16/9' } = Astro.props;
const paddingBottom = aspectRatio === '16/9' ? '56.25%' : '75%';
---

<div class="relative w-full overflow-hidden rounded-2xl shadow-md" style={`padding-bottom: ${paddingBottom}`}>
  <lite-youtube
    class="absolute inset-0 h-full w-full"
    style="position: absolute; max-width: none"
    videoid={videoId}
    title={title}
    playlabel={`再生: ${title}`}
  ></lite-youtube>
</div>

<script>
  import 'lite-youtube-embed';
</script>
