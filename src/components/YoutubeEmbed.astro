---
interface Props {
  videoId: string;
  title?: string;
  aspectRatio?: '16/9' | '4/3';
}

const { videoId, title = 'YouTube動画', aspectRatio = '16/9' } = Astro.props;
const paddingBottom = aspectRatio === '16/9' ? '56.25%' : '75%';
---

<div class="relative w-full overflow-hidden rounded-2xl shadow-md" style={`padding-bottom: ${paddingBottom}`}>
  <iframe
    class="absolute top-0 left-0 w-full h-full"
    src={`https://www.youtube-nocookie.com/embed/${videoId}`}
    title={title}
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
    allowfullscreen
    loading="lazy"
    referrerpolicy="strict-origin-when-cross-origin"
  ></iframe>
</div>
