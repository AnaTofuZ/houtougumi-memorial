      <!-- Links -->
      <nav class="flex flex-wrap gap-4 justify-center text-sm text-[#555555]">
        <a href="/" class="hover:text-[#EE3F87] transition-colors">トップ</a>
        <a href="/members/momojiru" class="hover:text-[#C55070] transition-colors">宝灯桃汁</a>
